# discuss.watch Environment Variables
# Copy this file to .env.local and fill in the values

# Admin access (platform-level admin routes and tenant dashboards)
# Bearer token accepted by verifyAdminAuth. CRON_SECRET also works.
# ADMIN_SECRET=your_admin_secret_here

# Database (Railway Postgres or any Postgres-compatible database)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=your_database_url_here

# Anthropic (https://console.anthropic.com) — default LLM provider
# Haiku classifies grants; Sonnet writes the daily brief summary.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Cloud — set LLM_PROVIDER=ollama to route all model calls here
# (instant rollback: unset LLM_PROVIDER to use Anthropic again).
# LLM_PROVIDER=ollama
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_BASE_URL=https://ollama.com
# LLM_MODEL=glm-5.2
# High-volume grants classify SKU (Low usage). Falls back to LLM_MODEL if unset.
# LLM_MODEL_CLASSIFY=gpt-oss:20b-cloud

# Resend (https://resend.com) — Email delivery for digests
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=discuss.watch <digest@discuss.watch>

# Public app URL — Used in digest email links
NEXT_PUBLIC_APP_URL=https://discuss.watch

# GitHub Token — For GitHub Discussions integration
# Create a PAT at https://github.com/settings/tokens with public_repo scope
# Optional: without this, GitHub Discussions sources will be skipped
GITHUB_TOKEN=your_github_token_here

# Redis — Server-side forum cache
# REDIS_URL=redis://localhost:6379

# Cron secret — Railway cron jobs use this to authenticate
# Generate a random string, e.g.: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Snapshot — Optional API key for governance voting data
# SNAPSHOT_API_KEY=your_snapshot_api_key_here

# Anticapture — Governance terminal (/governance). Optional; dashboards degrade
# gracefully when unset. ANTICAPTURE_MCP_URL overrides the default gateway endpoint.
# ANTICAPTURE_API_KEY=your_anticapture_api_key_here
# ANTICAPTURE_MCP_URL=https://mcp.anticapture.com/mcp

# Delegate Monitoring — Encryption key for API keys at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
